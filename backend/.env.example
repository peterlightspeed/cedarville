# Copy to .env and fill in real values. Never commit .env.
APP_NAME=Cedarville Schools API
APP_VERSION=0.1.0
APP_ENV=development
APP_DEBUG=true

# Where the JSON content lives. Defaults to ../site/data when unset.
# CONTENT_DIR=/app/content

# Comma-separated, exact origins. No wildcards, no trailing slashes.
CORS_ORIGINS=http://localhost:5000,http://127.0.0.1:5000

# Seconds a content response may be cached by the browser/CDN.
CONTENT_CACHE_SECONDS=300

# Contact form submissions per IP per minute.
RATE_LIMIT_PER_MINUTE=30

# Where contact submissions are appended (JSONL).
# SUBMISSIONS_FILE=/app/var/submissions.jsonl
