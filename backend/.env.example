# Copy to .env and fill in real values. Never commit .env.
APP_NAME=Cedarville Learning API
APP_VERSION=0.4.0
APP_ENV=development
APP_DEBUG=true

# ---- Database -------------------------------------------------------------
# Leave blank locally (uses a SQLite file). In production paste the Neon string:
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require
# DATABASE_URL=

# ---- Security -------------------------------------------------------------
# Required in production.  Generate with:  openssl rand -hex 32
SECRET_KEY=
# Parents with these emails see the Teacher tools (add videos, approve questions)
ADMIN_EMAILS=

# ---- Web addresses --------------------------------------------------------
# Exact origins, comma-separated, no wildcards, no trailing slashes.
CORS_ORIGINS=http://localhost:5000,http://127.0.0.1:5000,https://localhost,capacitor://localhost
# Where Paystack sends parents after paying
APP_URL=http://localhost:5000/app/

# ---- Payments (Paystack) --------------------------------------------------
PAYSTACK_SECRET_KEY=

# ---- AI helper (Cedar the Owl) --------------------------------------------
GOOGLE_CLIENT_ID=
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-5-5
AI_DAILY_LIMIT_PER_CHILD=20

# ---- Plan limits ------------------------------------------------------------
FREE_MAX_CHILDREN=1
PREMIUM_MAX_CHILDREN=5
FREE_PRACTICE_PER_DAY=1
FREE_SUBJECTS=letters,numbers,colours,maths
FREE_AI_PER_DAY=3

# ---- Existing website content ------------------------------------------------
CONTENT_CACHE_SECONDS=300
RATE_LIMIT_PER_MINUTE=30
